{
  "name": "licklab",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "LickLab — store jazz licks and try them over real standards. Local-first PWA + thin Worker API + D1.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "budget": "node scripts/budget-check.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "db:migrate:local": "wrangler d1 migrations apply licklab --local",
    "db:migrate:prod": "wrangler d1 migrations apply licklab --remote",
    "deploy:preview": "wrangler versions upload",
    "deploy:prod": "wrangler deploy",
    "cf:check": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "verovio": "^6.3.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.0",
    "dependency-cruiser": "^17.0.0",
    "eslint": "^9.18.0",
    "eslint-plugin-boundaries": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^3.23.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.28.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=20"
  }
}
